# W_GF_IO4_DDR

# These lines are used to feed the GBUFs in SW_term
S_GBUF_FEED_BEG[0|1|2|3],S_GBUF_FEED_END[0|1|2|3]
S_GBUF_FEED_BEG[0|1|2|3],[A_OUT|A_OUT|A_OUT|A_OUT]
S_GBUF_FEED_BEG[0|1|2|3],[B_OUT|B_OUT|B_OUT|B_OUT]
S_GBUF_FEED_BEG[0|1|2|3],[C_OUT|C_OUT|C_OUT|C_OUT]
S_GBUF_FEED_BEG[0|1|2|3],[D_OUT|D_OUT|D_OUT|D_OUT]
S_GBUF_FEED_BEG[0|1|2|3],W1END[1|2|3|0]
S_GBUF_FEED_BEG[0|1|2|3],W2END[7|6|5|4]

# Global nets
A_[CLK|CLK|CLK|CLK],N_GBUF_END[0|1|2|3]
B_[CLK|CLK|CLK|CLK],N_GBUF_END[0|1|2|3]
C_[CLK|CLK|CLK|CLK],N_GBUF_END[0|1|2|3]
D_[CLK|CLK|CLK|CLK],N_GBUF_END[0|1|2|3]
N_GBUF_BEG[0|1|2|3],N_GBUF_END[0|1|2|3]

# Shared CLK, SR, EN
GCLK_BEG[0|0|0|0],N_GBUF_END[0|1|2|3]
GSR_BEG[0|0|0|0|0|0|0|0],[N_GBUF_END0|N_GBUF_END1|N_GBUF_END2|N_GBUF_END3|W2END4|W2END2|W1END2|VCC0]
GEN_BEG[0|0|0|0|0|0|0|0],[N_GBUF_END0|N_GBUF_END1|N_GBUF_END2|N_GBUF_END3|W2END5|W2END3|W1END3|GND0]

# Share input mutiplexer
A_IN_MUX_BEG[0|0|0|0|0|0|0|0],[W6END0|WW4END0|W2MID0|W2END4|W2END0|W1END0|VCC0|GND0]
B_IN_MUX_BEG[0|0|0|0|0|0|0|0],[W6END1|WW4END1|W2MID1|W2END5|W2END1|W1END1|VCC0|GND0]
C_IN_MUX_BEG[0|0|0|0|0|0|0|0],[W6END2|WW4END2|W2MID2|W2END6|W2END2|W1END2|VCC0|GND0]
D_IN_MUX_BEG[0|0|0|0|0|0|0|0],[W6END3|WW4END3|W2MID3|W2END7|W2END3|W1END3|VCC0|GND0]

# Fabric to PAD output multiplexers
A_[IN|IN],[A_ODDR_Q|A_IN_MUX_END0]
B_[IN|IN],[B_ODDR_Q|B_IN_MUX_END0]
C_[IN|IN],[C_ODDR_Q|C_IN_MUX_END0]
D_[IN|IN],[D_ODDR_Q|D_IN_MUX_END0]

# Tristate control for those PADs
A_[EN|EN|EN|EN|EN|EN|EN|EN],[W6END4|WW4END4|W2MID4|W2END4|W2END0|W1END0|VCC0|GND0]
B_[EN|EN|EN|EN|EN|EN|EN|EN],[W6END5|WW4END5|W2MID5|W2END5|W2END1|W1END1|VCC0|GND0]
C_[EN|EN|EN|EN|EN|EN|EN|EN],[W6END6|WW4END6|W2MID6|W2END6|W2END2|W1END2|VCC0|GND0]
D_[EN|EN|EN|EN|EN|EN|EN|EN],[W6END7|WW4END7|W2MID7|W2END7|W2END3|W1END3|VCC0|GND0]

# ODDR

A_ODDR_CLK,GCLK_END0
B_ODDR_CLK,GCLK_END0
C_ODDR_CLK,GCLK_END0
D_ODDR_CLK,GCLK_END0

A_ODDR_EN,GEN_END0
B_ODDR_EN,GEN_END0
C_ODDR_EN,GEN_END0
D_ODDR_EN,GEN_END0

A_ODDR_SR,GSR_END0
B_ODDR_SR,GSR_END0
C_ODDR_SR,GSR_END0
D_ODDR_SR,GSR_END0

A_ODDR_[D0],[A_IN_MUX_END0]
A_ODDR_[D1|D1|D1|D1|D0|D0|D0|D0],[W6END0|WW4END0|W2MID0|W2END4|W2END0|W1END0|VCC0|GND0]

B_ODDR_[D0],[D_IN_MUX_END0]
B_ODDR_[D1|D1|D1|D1|D0|D0|D0|D0],[W6END1|WW4END1|W2MID1|W2END5|W2END1|W1END1|VCC0|GND0]

C_ODDR_[D0],[C_IN_MUX_END0]
C_ODDR_[D1|D1|D1|D1|D0|D0|D0|D0],[W6END2|WW4END2|W2MID2|W2END6|W2END2|W1END2|VCC0|GND0]

D_ODDR_[D0],[B_IN_MUX_END0]
D_ODDR_[D1|D1|D1|D1|D0|D0|D0|D0],[W6END3|WW4END3|W2MID3|W2END7|W2END3|W1END3|VCC0|GND0]

# IDDR

A_IDDR_CLK,GCLK_END0
B_IDDR_CLK,GCLK_END0
C_IDDR_CLK,GCLK_END0
D_IDDR_CLK,GCLK_END0

A_IDDR_EN,GEN_END0
B_IDDR_EN,GEN_END0
C_IDDR_EN,GEN_END0
D_IDDR_EN,GEN_END0

A_IDDR_SR,GSR_END0
B_IDDR_SR,GSR_END0
C_IDDR_SR,GSR_END0
D_IDDR_SR,GSR_END0

A_IDDR_D,A_OUT
B_IDDR_D,B_OUT
C_IDDR_D,C_OUT
D_IDDR_D,D_OUT

### # single just go back, we swap bits in vector to get more twists into the graph
E1BEG[0|1|2|3],W1END[3|2|1|0]
# Single get connected to PAD output
E1BEG[0|1|2|3],[A_OUT|B_OUT|C_OUT|D_OUT]

E1BEG[0|1|2|3],[A_IDDR_Q0|B_IDDR_Q0|C_IDDR_Q0|D_IDDR_Q0]
E1BEG[0|1|2|3],[A_IDDR_Q1|B_IDDR_Q1|C_IDDR_Q1|D_IDDR_Q1]

# we also connect the hex wires
# Note that we only have 2 wires starting in each CLB (so 2x6=12 wires in the channel)
# we connect the combinatorial outputs in every other column and the register outputs in the remaining columns
E6BEG[0|1|6|7],[A_OUT|B_OUT|C_OUT|D_OUT]
E6BEG[2|3|8|9],[A_OUT|B_OUT|C_OUT|D_OUT]
E6BEG[4|5|10|11],[A_OUT|B_OUT|C_OUT|D_OUT]

E6BEG[0|1|6|7],[A_IDDR_Q0|B_IDDR_Q0|C_IDDR_Q0|D_IDDR_Q0]
E6BEG[2|3|8|9],[A_IDDR_Q0|B_IDDR_Q0|C_IDDR_Q0|D_IDDR_Q0]
E6BEG[4|5|10|11],[A_IDDR_Q0|B_IDDR_Q0|C_IDDR_Q0|D_IDDR_Q0]

E6BEG[0|1|6|7],[A_IDDR_Q1|B_IDDR_Q1|C_IDDR_Q1|D_IDDR_Q1]
E6BEG[2|3|8|9],[A_IDDR_Q1|B_IDDR_Q1|C_IDDR_Q1|D_IDDR_Q1]
E6BEG[4|5|10|11],[A_IDDR_Q1|B_IDDR_Q1|C_IDDR_Q1|D_IDDR_Q1]

E6BEG[0|1|6|7],W6END[11|10|9|8]
E6BEG[2|3|8|9],W6END[7|6|5|4]
E6BEG[4|5|10|11],W6END[3|2|1|0]

E6BEG[0|1|6|7],WW4END[11|10|9|8]
E6BEG[2|3|8|9],WW4END[7|6|5|4]
E6BEG[4|5|10|11],WW4END[3|2|1|0]

E6BEG[0|1|6|7],W1END[2|3|1|0]
E6BEG[2|3|8|9],WW4END[15|14|13|12]
E6BEG[4|5|10|11],W1END[2|3|1|0]

# The MID are half way in so they get connected to the longest patch (S2BEG)
# The END are longest so get on the cascading begin (S2BEGb)
# on top we twist wire indexes for more entropy
E2BEGb[0|1|2|3|4|5|6|7],W2END[7|6|5|4|3|2|1|0]
E2BEGb[0|1|2|3|4|5|6|7],WW4END[7|6|5|4|3|2|1|0]
E2BEGb[0|1|2|3|4|5|6|7],WW4END[15|14|13|12|11|10|9|8]
E2BEGb[0|1|2|3|4|5|6|7],W6END[7|6|5|4|3|2|1|0]

E2BEG[0|1|2|3|4|5|6|7],W2MID[7|6|5|4|3|2|1|0]
E2BEG[0|1|2|3|4|5|6|7],WW4END[7|6|5|4|3|2|1|0]
E2BEG[0|1|2|3|4|5|6|7],WW4END[15|14|13|12|11|10|9|8]
E2BEG[0|1|2|3|4|5|6|7],W6END[7|6|5|4|3|2|1|0]

E2BEG[0|1|2|3|4|5|6|7],[A_IDDR_Q0|B_IDDR_Q0|C_IDDR_Q0|D_IDDR_Q0|A_IDDR_Q1|B_IDDR_Q1|C_IDDR_Q1|D_IDDR_Q1]

EE4BEG[0|0|0|0],[A_OUT|W6END0|W6END2|W6END4]
EE4BEG[1|1|1|1],[B_OUT|W6END6|W6END8|W6END10]
EE4BEG[2|2|2|2],[C_OUT|W6END1|W6END3|W6END5]
EE4BEG[3|3|3|3],[D_OUT|W6END7|W6END9|W6END11]
EE4BEG[4|4|4|4],[A_IDDR_Q0|W2END2|W2END4|W2END6]
EE4BEG[5|5|5|5],[B_IDDR_Q0|W2END3|W2END5|W2END7]
EE4BEG[6|6|6|6],[C_IDDR_Q0|W2MID2|W2MID4|W2MID6]
EE4BEG[7|7|7|7],[D_IDDR_Q0|W2MID3|W2MID5|W2MID7]
EE4BEG[8|8|8|8],[A_IDDR_Q1|W6END6|W6END8|W6END10]
EE4BEG[9|9|9|9],[B_IDDR_Q1|W6END3|W6END5|W6END7]
EE4BEG1[0|0|0|0],[A_OUT|W6END0|W6END2|W6END4]
EE4BEG1[1|1|1|1],[B_OUT|W6END6|W6END8|W6END10]
EE4BEG1[2|2|2|2],[C_OUT|W6END1|W6END3|W6END5]
EE4BEG1[3|3|3|3],[D_OUT|W6END7|W6END9|W6END11]
EE4BEG1[4|4|4|4],[C_IDDR_Q1|W2MID2|W2MID4|W2MID6]
EE4BEG1[5|5|5|5],[D_IDDR_Q1|W2MID3|W2MID5|W2MID7]


